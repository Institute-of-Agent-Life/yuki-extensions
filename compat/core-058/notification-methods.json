{
  "revision": 1,
  "status": "candidate",
  "methods": {
    "notification.publish": {
      "revision": 1,
      "direction": "plugin_to_host",
      "grant": "notification.publish",
      "params": {
        "type": "object",
        "properties": {
          "event_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "external_source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "event_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "target": {
            "type": "object",
            "properties": {
              "target_type": {
                "enum": [
                  "private",
                  "group"
                ]
              },
              "target_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "conversation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "target_type",
              "target_id"
            ],
            "additionalProperties": false
          },
          "occurred_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "payload": {
            "type": "object"
          },
          "text": {
            "type": "string",
            "maxLength": 12000
          },
          "media_handles": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "ask_agent": {
            "type": "boolean"
          },
          "resume_waiting_work": {
            "type": "boolean"
          },
          "agent_intent": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "event_key",
          "external_source",
          "event_type",
          "target",
          "occurred_at",
          "summary"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "notification_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_event_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "event_created": {
            "type": "boolean"
          },
          "delivery_enqueued": {
            "type": "boolean"
          },
          "agent_turn_enqueued": {
            "type": "boolean"
          },
          "deduplicated": {
            "type": "boolean"
          },
          "agent_execution": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "enum": [
              "published",
              "erased"
            ]
          },
          "deliveries": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "properties": {
                "ordinal": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "operation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "state": {
                  "enum": [
                    "pending",
                    "confirmed",
                    "failed",
                    "unknown",
                    "erased"
                  ]
                }
              },
              "required": [
                "ordinal",
                "operation",
                "state"
              ],
              "additionalProperties": false
            }
          },
          "sources": {
            "type": "object",
            "properties": {
              "ids": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                "maxItems": 128
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "complete": {
                "type": "boolean"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "ids",
              "count",
              "complete",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "notification_id",
          "source_event_id",
          "event_created",
          "delivery_enqueued",
          "agent_turn_enqueued",
          "deduplicated",
          "agent_execution",
          "state",
          "deliveries",
          "sources"
        ],
        "additionalProperties": false
      }
    },
