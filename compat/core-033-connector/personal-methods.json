    "work.input": {
      "direction": "plugin_to_host",
      "revision": 1,
      "grant": "personal.work",
      "params": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "request": {
            "additionalProperties": false,
            "properties": {
              "agent_target": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "cwd": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "device_id": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
