                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "intent": {
                        "anyOf": [
                          {
                            "enum": [
                              "prompt",
                              "watch",
                              "queue",
                              "steer",
                              "respond",
                              "cancel",
                              "detach"
                            ],
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "operation_id": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "option_id": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "permission_id": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "response": {
                        "anyOf": [
                          {
                            "additionalProperties": {},
                            "type": "object"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "session_id": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "request_id": {
                "format": "uuid4",
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "request_id",
              "text"
            ],
            "type": "object"
          }
        },
        "required": [
          "handle",
          "request"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object"
      }
    },
