      "direction": "plugin_to_host",
      "revision": 1,
      "grant": "personal.auth",
      "params": {
        "type": "object",
        "properties": {
          "proof": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "proof"
        ],
        "additionalProperties": false
      },
      "result": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "scope": {
            "enum": [
              "work",
              "native"
            ]
          },
          "expires_in": {
            "type": "integer"
          }
        },
        "required": [
          "handle",
          "scope",
          "expires_in"
        ],
        "additionalProperties": false
      }
    },
